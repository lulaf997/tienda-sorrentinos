# Copiá este archivo a ".env" y completá tus datos reales.
# El archivo ".env" NO se sube a git (ver .gitignore) y en Vercel se carga
# aparte en Project Settings > Environment Variables.

VITE_STORE_NAME="Sorrentinos Caceros"
VITE_STORE_TAGLINE="Pedí online, retirá o coordiná el envío por WhatsApp"

# Tu número de WhatsApp SIN el "+", con código de país.
# Ej: Argentina, 11 1234-5678 -> 5491112345678
VITE_WHATSAPP_NUMBER=5491112345678

# URL del Google Sheet de productos, publicado como CSV. Ver README paso 1.
VITE_SHEET_CSV_URL=

# URL del Google Apps Script (Web App) para registrar pedidos. Ver README paso 2.
VITE_APPS_SCRIPT_URL=
